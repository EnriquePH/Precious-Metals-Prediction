    shiny,
    shinythemes,
    DT,
    markdown,
    TTR,
    quantmod,
    ggplot2,
    plotly,
    patchwork,
    forecast,
    zoo
Suggests:
    testthat (>= 3.0.0),
    quarto,
    knitr
Config/testthat/edition: 3
Encoding: UTF-8
