# R session / workspace
.Rhistory
.RData
.Ruserdata
*.Rout

# RStudio
# (the .Rproj file itself IS tracked; only per-user state is ignored)
.Rproj.user/

# Shiny / shinyapps.io deployment metadata (account-specific)
rsconnect/
rsconnect/documents/*.dcf

# Secrets / local environment overrides
.Renviron
.Renviron.local
.env

# LaTeX (in case of knitr -> PDF output)
*.log
*.aux
*.synctex.gz
*.blg

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Project-specific build artifacts
README.html
docs/

# Generated PDF reports (report_usd.R / report_eur.R) and Quarto build state
reports/
/.quarto/
report-template.pdf
report-template_files/
